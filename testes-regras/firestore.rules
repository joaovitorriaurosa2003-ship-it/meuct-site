rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MeuRH (desativado em 05/10/2026): empresas, funcionarios, tarefas, respostas,
    // apresentacoes e salas nao tem mais regra de acesso, entao ninguem le nem grava.
    // Os dados continuam guardados no banco.

    // ---------- CT Integrado (Meia Noite EC) ----------
    // Agora com autenticação e permissão por módulo, em vez de acesso aberto.

    function ctEstaLogado() { return request.auth != null; }

    function ctEhAdmin() {
      return ctEstaLogado()
        && get(/databases/$(database)/documents/ct_usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    // Botões de apagar: admin ou quem o admin liberou (campo pode_apagar no usuário).
    function ctPodeApagar() {
      return ctEhAdmin() || (ctEstaLogado()
        && get(/databases/$(database)/documents/ct_usuarios/$(request.auth.uid)).data.get('pode_apagar', false) == true);
    }

    // Relatórios cruzados: Diretoria e quem o admin liberar (campo pode_cruzar) leem todas as áreas.
    function ctPodeCruzar() {
      return ctEstaLogado() && ctEmailOk() && get(/databases/$(database)/documents/ct_usuarios/$(request.auth.uid)).data.get('pode_cruzar', false) == true;
    }

    // Conta nova (convidada) só vale depois de confirmar o e-mail. Contas antigas e o fundador não têm a marca.
    function ctEmailOk() {
      return get(/databases/$(database)/documents/ct_usuarios/$(request.auth.uid)).data.get('verificar_email', false) != true
        || request.auth.token.email_verified == true;
    }

    function ctTemAcesso(modulo) {
      return ctEstaLogado() && (
        ctEhAdmin() ||
        (ctEmailOk() && (modulo in get(/databases/$(database)/documents/ct_usuarios/$(request.auth.uid)).data.modulos || 'diretoria' in get(/databases/$(database)/documents/ct_usuarios/$(request.auth.uid)).data.modulos))
      );
    }

    // Conteúdo clínico da Psicologia: só quem tem o módulo Psicologia e o admin (a Diretoria não entra).
    function ctSoPsicologia() {
      return ctEhAdmin() || (ctEstaLogado() && ctEmailOk() && 'psicologia' in ctMeuCadastro().modulos);
    }

    function ctMeuCadastro() {
      return get(/databases/$(database)/documents/ct_usuarios/$(request.auth.uid)).data;
    }
    // Quem criou o item pode apagar o que é seu.
    function ctEhAutor() {
      return ctEstaLogado() && (
        resource.data.get('criado_por', '') == request.auth.uid
        || resource.data.get('autor_uid', '') == request.auth.uid
        || resource.data.get('remetente_uid', '') == request.auth.uid);
    }
    function ctPodeJogos() {
      return ctTemAcesso('treinador') || ctTemAcesso('desempenho');
    }

    // usuarios: cada um só cria/lê o próprio documento (menos admin, que lê/edita todos).
    // O create só é aceito se o papel bater com a regra do e-mail fundador — impede
    // que alguém se autopromova a admin editando o payload do cadastro.
    match /ct_usuarios/{uid} {
      allow read: if ctEstaLogado() && (request.auth.uid == uid || ctEhAdmin());
      allow create: if ctEstaLogado() && request.auth.uid == uid && !('pode_apagar' in request.resource.data) && !('pode_cruzar' in request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && (
          (request.auth.token.email == 'joaovitorriaurosa2003@gmail.com' && request.resource.data.role == 'admin')
          ||
          (request.auth.token.email != 'joaovitorriaurosa2003@gmail.com' && request.resource.data.role == 'colaborador'
          && request.resource.data.get('verificar_email', false) == true
          && exists(/databases/$(database)/documents/ct_convites/$(request.auth.token.email))
          && request.resource.data.modulos == get(/databases/$(database)/documents/ct_convites/$(request.auth.token.email)).data.modulos)
        );
      allow update: if ctEhAdmin();
      allow delete: if ctEhAdmin() && request.auth.uid != uid;
    }
        // Atualizações da plataforma (aba "Atualizações") — leitura pra
    // qualquer usuário logado, escrita/exclusão só pra admin.
    match /ct_atualizacoes/{id} {
      allow read: if ctEhEquipe();
      allow create, update: if ctEhAdmin();
      allow delete: if ctPodeApagar() || ctEhAutor();
    }

    // Gerenciar o cadastro do atleta (criar, editar, mesclar, excluir) fica
    // liberado pra Admin, Treinador, Psicologia e Serviço Social — as áreas
    // que mais precisam manter o elenco atualizado no dia a dia. Fisioterapia,
    // Fisiologia e Desempenho só leem (podem navegar o elenco, não editar).
    function ctPodeGerenciarAtletas() {
      return ctEhAdmin() || ctTemAcesso('treinador') || ctTemAcesso('psicologia') || ctTemAcesso('social');
    }
    match /fotos_atletas/{arquivo} {
      allow read, write: if false;
    }
    match /ct_atletas/{atletaId} {
      allow read: if ctEhEquipe();
      allow create, update: if ctPodeGerenciarAtletas();
      allow delete: if ctPodeApagar() || ctEhAutor();
    }

    match /ct_atletas/{atletaId}/ct_psi_avaliacoes/{docId} {
      allow read: if ctTemAcesso('psicologia') || ctTemAcesso('treinador') || ctPodeCruzar() || ctEhEquipe();
      allow create, update: if ctTemAcesso('psicologia');
      allow delete: if ctPodeApagar() || ctEhAutor();
    }
    match /ct_atletas/{atletaId}/ct_fisio_registros/{docId} {
      allow read: if ctTemAcesso('fisioterapia') || ctTemAcesso('treinador') || ctPodeCruzar() || ctEhEquipe();
      allow create, update: if ctTemAcesso('fisioterapia');
      allow delete: if ctPodeApagar() || ctEhAutor();
    }
    match /ct_atletas/{atletaId}/ct_fisiologia_dados/{docId} {
      allow read: if ctTemAcesso('fisiologia') || ctTemAcesso('treinador') || ctPodeCruzar() || ctEhEquipe();
      allow create, update: if ctTemAcesso('fisiologia');
      allow delete: if ctPodeApagar() || ctEhAutor();
    }
    match /ct_atletas/{atletaId}/ct_social_acompanhamento/{docId} {
      allow read: if ctTemAcesso('social') || ctTemAcesso('treinador') || ctPodeCruzar() || ctEhEquipe();
      allow create, update: if ctTemAcesso('social');
      allow delete: if ctPodeApagar() || ctEhAutor();
    }
    match /ct_atletas/{atletaId}/ct_performance_jogos/{docId} {
      allow read: if ctTemAcesso('desempenho') || ctTemAcesso('treinador') || ctPodeCruzar() || ctEhEquipe();
      allow create, update: if ctTemAcesso('desempenho');
      allow delete: if ctPodeApagar() || ctEhAutor();
    }
    match /ct_atletas/{atletaId}/ct_medicina_registros/{docId} {
      allow read: if ctTemAcesso('medicina') || ctTemAcesso('treinador') || ctPodeCruzar() || ctEhEquipe();
      allow create, update: if ctTemAcesso('medicina');
      allow delete: if ctPodeApagar() || ctEhAutor();
    }

    // Versões collection group — necessárias pro carregamento em lote
    // (o front-end usa collectionGroup pra montar o semáforo e os gráficos).
    match /{path=**}/ct_psi_avaliacoes/{docId} {
      allow read: if ctTemAcesso('psicologia') || ctTemAcesso('treinador') || ctPodeCruzar() || ctEhEquipe();
      allow create, update: if ctTemAcesso('psicologia');
      allow delete: if ctPodeApagar() || ctEhAutor();
    }
    match /{path=**}/ct_fisio_registros/{docId} {
      allow read: if ctTemAcesso('fisioterapia') || ctTemAcesso('treinador') || ctPodeCruzar() || ctEhEquipe();
      allow create, update: if ctTemAcesso('fisioterapia');
      allow delete: if ctPodeApagar() || ctEhAutor();
    }
    match /{path=**}/ct_fisiologia_dados/{docId} {
      allow read: if ctTemAcesso('fisiologia') || ctTemAcesso('treinador') || ctPodeCruzar() || ctEhEquipe();
      allow create, update: if ctTemAcesso('fisiologia');
      allow delete: if ctPodeApagar() || ctEhAutor();
    }
    match /{path=**}/ct_social_acompanhamento/{docId} {
      allow read: if ctTemAcesso('social') || ctTemAcesso('treinador') || ctPodeCruzar() || ctEhEquipe();
      allow create, update: if ctTemAcesso('social');
      allow delete: if ctPodeApagar() || ctEhAutor();
    }
    match /{path=**}/ct_performance_jogos/{docId} {
      allow read: if ctTemAcesso('desempenho') || ctTemAcesso('treinador') || ctPodeCruzar() || ctEhEquipe();
      allow create, update: if ctTemAcesso('desempenho');
      allow delete: if ctPodeApagar() || ctEhAutor();
    }
    match /{path=**}/ct_medicina_registros/{docId} {
      allow read: if ctTemAcesso('medicina') || ctTemAcesso('treinador') || ctPodeCruzar() || ctEhEquipe();
      allow create, update: if ctTemAcesso('medicina');
      allow delete: if ctPodeApagar() || ctEhAutor();
    }
    // ---------- Agenda, jogos e carga de treino ----------
    // Qualquer pessoa da equipe (admin ou com algum módulo liberado) vê e lança eventos;
    // excluir fica com o admin, a comissão técnica ou quem criou o evento.
    function ctEhEquipe() {
      return ctEstaLogado() && (
        ctEhAdmin() ||
        (get(/databases/$(database)/documents/ct_usuarios/$(request.auth.uid)).data.modulos.size() > 0 && ctEmailOk())
      );
    }
    // ---------- Comissao tecnica (cadastro escolhido em cada jogo) ----------
    match /ct_comissao/{id} {
      allow read: if ctEhEquipe();
      allow create, update: if (ctEhAdmin() || ctTemAcesso('treinador') || ctTemAcesso('desempenho'))
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() < 61;
      allow delete: if ctPodeApagar() || ctEhAutor();
    }

    // ---------- Times adversarios (nome, cidade, estadio, competicoes e escudo) ----------
    match /ct_times/{id} {
      allow read: if ctEhEquipe();
      allow create, update: if (ctEhAdmin() || ctTemAcesso('treinador') || ctTemAcesso('desempenho'))
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 60
        && (!('escudo' in request.resource.data) || request.resource.data.escudo == null || (request.resource.data.escudo is string && request.resource.data.escudo.size() < 250000));
      allow delete: if ctPodeApagar() || ctEhAutor();
    }

    match /ct_eventos/{id} {
      allow read: if ctEhEquipe();
      allow create: if ctEhEquipe() && (request.resource.data.get('tipo', '') != 'jogo' || ctPodeJogos());
      allow update: if ctEhEquipe() && ((resource.data.get('tipo', '') != 'jogo' && request.resource.data.get('tipo', '') != 'jogo') || ctPodeJogos()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cargas', 'atualizado_em']));
      allow delete: if ctPodeApagar() || ctEhAutor();
    }

    // ---------- Check-in diário do atleta (link individual, sem login) ----------
    function ctPodeGerirCheckin() {
      return ctEhAdmin() || ctTemAcesso('psicologia') || ctTemAcesso('fisiologia') || ctTemAcesso('treinador');
    }
    function ctPodeVerCheckin() {
      return ctEhAdmin() || ctTemAcesso('psicologia') || ctTemAcesso('fisiologia') || ctTemAcesso('fisioterapia') || ctTemAcesso('medicina') || ctTemAcesso('treinador') || ctEhEquipe();
    }
    // A página do atleta lê só o próprio link (pelo token); listar os links é só pra equipe.
    match /ct_checkin_links/{token} {
      allow get: if true;
      allow list: if ctPodeGerirCheckin();
      allow create, update: if ctPodeGerirCheckin();
      allow delete: if ctPodeApagar() || ctPodeGerirCheckin();
    }
    function ctNota15(v) {
      return v is int && v >= 1 && v <= 5;
    }
    // Resposta do atleta: só cria (não edita), um documento por link, dia e tipo, com o token
    // de um link ativo daquele mesmo atleta e todos os valores dentro da escala.
    function ctCheckinValido(id) {
      let d = request.resource.data;
      let link = get(/databases/$(database)/documents/ct_checkin_links/$(d.token)).data;
      return d.keys().hasOnly(['token', 'atletaId', 'data', 'tipo', 'sono', 'cansaco', 'dor', 'estresse', 'humor', 'pse', 'comentario', 'criado_em'])
        && d.token is string && d.token.size() >= 16 && d.token.size() <= 64
        && d.data is string && d.data.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && d.tipo in ['bemestar', 'pse']
        && id == d.token + '_' + d.data + '_' + d.tipo
        && link.ativo == true
        && link.atletaId == d.atletaId
        && d.criado_em == request.time
        && (!('comentario' in d) || (d.comentario is string && d.comentario.size() <= 280))
        && (
          (d.tipo == 'bemestar' && ctNota15(d.sono) && ctNota15(d.cansaco) && ctNota15(d.dor) && ctNota15(d.estresse) && ctNota15(d.humor) && !('pse' in d))
          || (d.tipo == 'pse' && d.pse is int && d.pse >= 0 && d.pse <= 10 && !('sono' in d) && !('cansaco' in d) && !('dor' in d) && !('estresse' in d) && !('humor' in d))
        );
    }
    match /ct_checkins/{id} {
      allow read: if ctPodeVerCheckin() || ctPodeCruzar();
      allow create: if ctCheckinValido(id);
      allow update: if ctEhAdmin();
      allow delete: if ctPodeApagar() || ctPodeGerirCheckin();
    }


    // ---------- Convites (primeiro acesso so para quem o admin convidou) ----------
    match /ct_convites/{email} {
      allow get: if ctEhAdmin() || (ctEstaLogado() && request.auth.token.email == email);
      allow list, create, update, delete: if ctEhAdmin();
    }

    // ---------- Registro de acessos (so o admin le; ninguem edita nem apaga) ----------
    match /ct_auditoria/{id} {
      allow read: if ctEhAdmin();
      allow create: if ctEhEquipe()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.criado_em == request.time
        && request.resource.data.keys().hasOnly(['uid', 'email', 'nome', 'acao', 'alvo', 'detalhe', 'criado_em']);
      allow update, delete: if false;
    }

    // ---------- Perfis da equipe (aba Usuários) ----------
    match /ct_perfis/{uid} {
      allow read: if ctEhEquipe();
      allow create, update: if ctEhEquipe() && (request.auth.uid == uid || ctEhAdmin());
      allow delete: if ctEhAdmin();
    }
    match /ct_captacao/{id} {
  allow read, create, update: if ctEhAdmin() || ctTemAcesso('treinador') || ctTemAcesso('social');
  allow delete: if ctEhAdmin();
}
match /ct_captacao_privado/{id} {
  allow read, write: if ctEhAdmin() || ctTemAcesso('social');
}

    // ---------- Avisos da equipe (pop-up e notificação no aparelho) ----------
    match /ct_avisos/{id} {
      allow read: if ctEhEquipe() && (ctEhAdmin()
        || request.auth.uid in resource.data.destinatarios
        || resource.data.remetente_uid == request.auth.uid);
      allow create: if ctEhEquipe()
        && request.resource.data.remetente_uid == request.auth.uid
        && request.resource.data.destinatarios is list
        && request.resource.data.destinatarios.size() > 0
        && request.resource.data.destinatarios.size() <= 300
        && request.resource.data.nivel in ['informativo', 'urgente']
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 120
        && request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 2000
        && request.resource.data.lidos == {}
        && !('push_enviado_em' in request.resource.data)
        && !('push_reservado_em' in request.resource.data);
      allow update: if ctEhEquipe()
        && request.auth.uid in resource.data.destinatarios
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lidos'])
        && request.resource.data.lidos.diff(resource.data.lidos).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if ctPodeApagar() || ctEhAutor();
    }
    match /ct_push_tokens/{token} {
      allow create, update: if ctEhEquipe() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'plataforma', 'atualizado_em'])
        && (!('plataforma' in request.resource.data) || (request.resource.data.plataforma is string && request.resource.data.plataforma.size() <= 200));
      allow delete: if ctEstaLogado() && resource.data.uid == request.auth.uid;
      allow read: if false;
    }
    match /ct_diretorio/{uid} {
      allow read: if ctEhEquipe();
      allow create, update: if ctEstaLogado() && request.auth.uid == uid
        && request.resource.data.get('diretoria', false) == ('diretoria' in ctMeuCadastro().get('modulos', []))
        && request.resource.data.get('admin', false) == (ctMeuCadastro().get('role', '') == 'admin')
        && request.resource.data.get('modulos', []) == ctMeuCadastro().get('modulos', []);
      allow delete: if ctEhAdmin();
    }

    // ---------- Scout de goleiros (aba Goleiros dos Treinadores) ----------
    match /ct_goleiros/{id} {
      allow read: if ctEhEquipe();
      allow create, update: if ctTemAcesso('treinador');
      allow delete: if ctPodeApagar() || ctEhAutor();
    }

    // QTS: quadro de trabalho semanal (treinadores e preparação física editam; equipe vê)
    match /ct_qts/{semana} {
      allow read: if ctEhEquipe();
      allow create, update: if ctTemAcesso('treinador') || ctTemAcesso('preparacao');
      allow delete: if ctPodeApagar() || ctTemAcesso('treinador') || ctTemAcesso('preparacao');
    }

    // Nutrição (DM): a Nutrição lança; o DM e a comissão técnica veem
    match /ct_atletas/{atletaId}/ct_nutricao_registros/{docId} {
      allow read: if ctTemAcesso('nutricao') || ctTemAcesso('fisioterapia') || ctTemAcesso('medicina') || ctTemAcesso('psicologia') || ctTemAcesso('treinador') || ctPodeCruzar() || ctEhEquipe();
      allow create, update: if ctTemAcesso('nutricao');
      allow delete: if ctPodeApagar() || ctEhAutor();
    }
    match /{path=**}/ct_nutricao_registros/{docId} {
      allow read: if ctTemAcesso('nutricao') || ctTemAcesso('fisioterapia') || ctTemAcesso('medicina') || ctTemAcesso('psicologia') || ctTemAcesso('treinador') || ctPodeCruzar() || ctEhEquipe();
      allow create, update: if ctTemAcesso('nutricao');
      allow delete: if ctPodeApagar() || ctEhAutor();
    }
    // Cardápio semanal do refeitório (Nutrição edita; equipe vê)
    // ---------- Dados restritos do atleta: CPF, contato e contrato (Serviço Social, Diretoria e admin) ----------
    match /ct_atletas_privado/{atletaId} {
      allow read, create, update: if ctTemAcesso('social');
      allow delete: if ctTemAcesso('social') || ctPodeApagar();
    }

    // ---------- Texto clínico (só a própria área, a Diretoria e o admin leem) ----------
    match /ct_texto_clinico_psi/{id} {
      allow read, create, update: if ctSoPsicologia();
      allow delete: if ctSoPsicologia() || ctPodeApagar() || ctEhAutor();
    }
    match /ct_texto_clinico_medicina/{id} {
      allow read, create, update: if ctTemAcesso('medicina');
      allow delete: if ctTemAcesso('medicina') || ctPodeApagar() || ctEhAutor();
    }

    // ---------- Meu QTS (grade semanal de cada usuário) e conflitos de horário ----------
    match /ct_qts_pessoal/{id} {
      allow read: if ctEhEquipe();
      allow create, update: if ctEhEquipe() && (request.resource.data.uid == request.auth.uid || ctEhAdmin());
      allow delete: if ctEstaLogado() && (resource.data.uid == request.auth.uid || ctEhAdmin());
    }
    match /ct_qts_conflitos/{id} {
      allow read: if ctEhEquipe();
      allow create: if ctEhEquipe() && request.resource.data.criado_por == request.auth.uid;
      allow update: if ctEhAdmin();
      allow delete: if ctPodeApagar() || (ctEstaLogado() && request.auth.uid in resource.data.get('envolvidos', []));
    }

    match /ct_cardapio/{semana} {
      allow read: if ctEhEquipe();
      allow create, update: if ctTemAcesso('nutricao');
      allow delete: if ctPodeApagar() || ctTemAcesso('nutricao');
    }

    // ---------- Entre setores e rotina (29/10/2026) ----------
    match /ct_restricoes/{id} {
      allow read: if ctEhEquipe();
      allow create: if ctEhEquipe() && request.resource.data.criado_por == request.auth.uid;
      allow update: if ctPodeApagar() || ctEhAutor();
      allow delete: if ctPodeApagar() || ctEhAutor();
    }

    match /ct_encaminhamentos/{id} {
      allow read: if ctEhEquipe() && (resource.data.de_uid == request.auth.uid || ctTemAcesso(resource.data.para_setor));
      allow create: if ctEhEquipe() && request.resource.data.de_uid == request.auth.uid;
      allow update: if ctEhEquipe() && (resource.data.de_uid == request.auth.uid || ctTemAcesso(resource.data.para_setor))
        && request.resource.data.de_uid == resource.data.de_uid;
      allow delete: if ctPodeApagar() || (ctEstaLogado() && resource.data.de_uid == request.auth.uid);
    }

    match /ct_alertas/{id} {
      allow read, create: if ctEhEquipe();
      allow delete: if ctPodeApagar();
    }

    match /ct_retorno_jogo/{id} {
      allow read: if ctEhEquipe();
      allow create, update: if ctTemAcesso('fisioterapia') || ctTemAcesso('medicina') || ctTemAcesso('preparacao');
      allow delete: if ctPodeApagar();
    }

    match /ct_viagens/{id} {
      allow read: if ctEhEquipe();
      allow create, update: if ctTemAcesso('social') || ctTemAcesso('treinador');
      allow delete: if ctPodeApagar() || ctEhAutor();
    }

    match /ct_testes_fisicos/{id} {
      allow read: if ctEhEquipe();
      allow create, update: if ctTemAcesso('preparacao');
      allow delete: if ctPodeApagar() || ctEhAutor();
    }

    // Agenda particular: só a própria pessoa lê e grava
    match /ct_agenda_pessoal/{id} {
      allow read, delete: if ctEstaLogado() && resource.data.uid == request.auth.uid;
      allow update: if ctEstaLogado() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow create: if ctEhEquipe() && request.resource.data.uid == request.auth.uid;
    }

    // Atas de reunião: quem tem acesso ao setor da ata lê e grava
    match /ct_atas/{id} {
      allow read: if ctTemAcesso(resource.data.setor);
      allow create: if ctTemAcesso(request.resource.data.setor) && request.resource.data.criado_por == request.auth.uid;
      allow update: if ctTemAcesso(resource.data.setor) && ctTemAcesso(request.resource.data.setor);
      allow delete: if ctPodeApagar() || ctEhAutor();
    }

    // Treinos de goleiros (ficha com nota de execução)
    match /ct_treinos_goleiro/{id} {
      allow read, create, update: if ctTemAcesso('treinador');
      allow delete: if ctPodeApagar() || (ctTemAcesso('treinador') && ctEhAutor());
    }

    // Avaliação por constructos dos atletas em avaliação: cada setor grava o seu (sem a Diretoria).
    match /ct_avaliacao_entrada/{id} {
      allow read: if ctEhEquipe();
      allow create, update: if ctEhEquipe()
        && request.resource.data.autor_uid == request.auth.uid
        && (ctEhAdmin() || request.resource.data.modulo in ctMeuCadastro().modulos);
      allow delete: if ctEhAdmin() || (ctEhEquipe() && resource.data.autor_uid == request.auth.uid);
    }

    // Documentos encaminhados: só quem enviou e quem recebeu leem; cada um só grava a própria assinatura.
    match /ct_documentos/{id} {
      allow read: if ctEhEquipe() && (ctEhAdmin()
        || request.auth.uid in resource.data.destinatarios
        || resource.data.remetente_uid == request.auth.uid);
      allow create: if ctEhEquipe()
        && request.resource.data.remetente_uid == request.auth.uid
        && request.resource.data.destinatarios is list
        && request.resource.data.destinatarios.size() > 0
        && request.resource.data.destinatarios.size() <= 50;
      allow update: if ctEhEquipe()
        && (request.auth.uid in resource.data.destinatarios || resource.data.remetente_uid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assinaturas', 'lidos'])
        && request.resource.data.assinaturas.diff(resource.data.assinaturas).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.lidos.diff(resource.data.lidos).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if ctEhAdmin() || (ctEhEquipe() && resource.data.remetente_uid == request.auth.uid);
      match /partes/{p} {
        allow read: if ctEhEquipe() && (ctEhAdmin()
          || request.auth.uid in get(/databases/$(database)/documents/ct_documentos/$(id)).data.destinatarios
          || get(/databases/$(database)/documents/ct_documentos/$(id)).data.remetente_uid == request.auth.uid);
        allow create: if ctEhEquipe() && get(/databases/$(database)/documents/ct_documentos/$(id)).data.remetente_uid == request.auth.uid;
        allow delete: if ctEhAdmin() || (ctEhEquipe() && get(/databases/$(database)/documents/ct_documentos/$(id)).data.remetente_uid == request.auth.uid);
      }
    }

    // ---------- Campeonatos (inscritos, tabela, cartões, classificação) ----------
    match /ct_campeonatos/{id} {
      allow read: if ctEhEquipe();
      allow create, update: if (ctEhAdmin() || ctPodeJogos() || ctTemAcesso('diretoria'))
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 120
        && (!('inscritos' in request.resource.data) || (request.resource.data.inscritos is list && request.resource.data.inscritos.size() <= 99));
      allow delete: if ctEhAdmin() || ctTemAcesso('diretoria') || ctEhAutor();
    }

    // Controle do robô de lembretes (só o robô grava, com a chave do servidor)
    match /ct_lembretes_enviados/{id} {
      allow read, write: if false;
    }

    // ---------- Conversas da equipe (bate-papo) ----------
    // Só quem participa lê e escreve; nem o admin lê conversa da qual não participa.
    match /ct_conversas/{cid} {
      allow read: if ctEhEquipe() && request.auth.uid in resource.data.membros;
      allow create: if ctEhEquipe()
        && request.resource.data.criado_por == request.auth.uid
        && request.resource.data.membros is list
        && request.auth.uid in request.resource.data.membros
        && request.resource.data.membros.size() <= 80
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 60
        && request.resource.data.tipo in ['direta', 'grupo', 'setor']
        && !('ultima' in request.resource.data)
        && (request.resource.data.tipo != 'direta' || (request.resource.data.membros.size() == 2
            && cid == 'd_' + request.resource.data.membros[0] + '_' + request.resource.data.membros[1]
            && request.resource.data.membros[0] < request.resource.data.membros[1]))
        && (request.resource.data.tipo != 'setor' || (cid == 's_' + request.resource.data.setor
            && request.resource.data.membros == [request.auth.uid]
            && request.resource.data.modulos is list
            && ctMeuCadastro().modulos.hasAny(request.resource.data.modulos)));
      allow update: if ctEhEquipe() && (
          // participante: última mensagem (só a própria), marca de leitura e silenciar (só a própria chave)
          (request.auth.uid in resource.data.membros
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultima', 'atualizado_em', 'lido_em', 'silenciado'])
            && (request.resource.data.get('ultima', null) == resource.data.get('ultima', null)
                || request.resource.data.ultima.autor_uid == request.auth.uid)
            && request.resource.data.get('lido_em', {}).diff(resource.data.get('lido_em', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.get('silenciado', {}).diff(resource.data.get('silenciado', {})).affectedKeys().hasOnly([request.auth.uid]))
          // entrar no grupo do próprio setor
          || (resource.data.tipo == 'setor' && ctMeuCadastro().modulos.hasAny(resource.data.modulos)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
            && request.resource.data.membros.toSet().difference(resource.data.membros.toSet()) == [request.auth.uid].toSet()
            && resource.data.membros.toSet().difference(request.resource.data.membros.toSet()).size() == 0)
          // admin tira do grupo do setor quem perdeu o módulo (sem ler as mensagens)
          || (ctEhAdmin() && resource.data.tipo == 'setor'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
            && request.resource.data.membros.toSet().difference(resource.data.membros.toSet()).size() == 0)
          // sair de um grupo
          || (resource.data.tipo == 'grupo' && request.auth.uid in resource.data.membros
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
            && resource.data.membros.toSet().difference(request.resource.data.membros.toSet()) == [request.auth.uid].toSet()
            && request.resource.data.membros.toSet().difference(resource.data.membros.toSet()).size() == 0)
          // quem criou o grupo muda nome e participantes
          || (resource.data.tipo == 'grupo' && resource.data.criado_por == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'membros', 'atualizado_em'])
            && request.auth.uid in request.resource.data.membros
            && request.resource.data.membros.size() <= 80
            && request.resource.data.nome is string && request.resource.data.nome.size() <= 60)
        );
      allow delete: if false;

      match /mensagens/{mid} {
        allow read: if ctEhEquipe() && request.auth.uid in get(/databases/$(database)/documents/ct_conversas/$(cid)).data.membros;
        allow create: if ctEhEquipe()
          && request.auth.uid in get(/databases/$(database)/documents/ct_conversas/$(cid)).data.membros
          && request.resource.data.keys().hasOnly(['autor_uid', 'autor_nome', 'texto', 'criado_em', 'apagada', 'atletas', 'resposta'])
          && request.resource.data.autor_uid == request.auth.uid
          && request.resource.data.criado_em == request.time
          && request.resource.data.apagada == false
          && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 2000
          && request.resource.data.autor_nome is string && request.resource.data.autor_nome.size() <= 80
          && (!('atletas' in request.resource.data) || (request.resource.data.atletas is list && request.resource.data.atletas.size() <= 5));
        allow update: if ctEhEquipe() && resource.data.autor_uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apagada', 'texto', 'atletas', 'resposta'])
          && request.resource.data.apagada == true && request.resource.data.texto == '';
        allow delete: if false;
      }
    }

    // Cronograma do dia da Fisioterapia (um documento por dia). No futuro, o atleta lê só o dia em que aparece (atletas_ids).
    match /ct_cronograma_fisio/{dia} {
      allow read: if ctEhEquipe();
      allow create, update: if ctTemAcesso('fisioterapia');
      allow delete: if ctEhAdmin() || ctTemAcesso('fisioterapia');
    }
  }
}